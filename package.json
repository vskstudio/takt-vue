{
  "name": "@vskstudio/takt-vue",
  "version": "0.7.0",
  "description": "Idiomatic Vue 3 wrapper for Takt privacy-friendly analytics",
  "license": "MIT",
  "author": "VSK Studio",
  "type": "module",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/element/index.js",
  "jsdelivr": "./dist/element/index.js",
  "sideEffects": [
    "./dist/element/index.js"
  ],
  "keywords": [
    "analytics",
    "privacy",
    "vue",
    "vue3",
    "takt"
  ],
  "homepage": "https://github.com/vskstudio/takt-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vskstudio/takt-vue.git"
  },
  "bugs": {
    "url": "https://github.com/vskstudio/takt-vue/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./directives": {
      "types": "./dist/directives/index.d.ts",
      "import": "./dist/directives/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "import": "./dist/element/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:element",
    "build:lib": "vite build",
    "build:element": "vite build --config vite.element.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && changeset publish",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@vskstudio/takt-core": ">=0.10.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vskstudio/takt-core": "^0.10.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^25.0.0",
    "size-limit": "^11.1.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.1.0"
  },
  "packageManager": "pnpm@9.0.0"
}
